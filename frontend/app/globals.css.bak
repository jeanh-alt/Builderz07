@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

/* Base Styles */
body {
  @apply bg-white text-engie-text-dark font-sans antialiased;
}

/* Typography */
h1, h2, h3, h4, h5, h6 {
  @apply text-engie-text-dark font-bold;
}

h1 { @apply text-2xl md:text-3xl; }
h2 { @apply text-xl md:text-2xl; }

a {
  @apply text-engie-primary hover:text-engie-primary-dark transition-colors;
}

/* Buttons */
.btn-primary {
  @apply bg-engie-primary text-white font-semibold py-2 px-4 rounded-md 
         hover:bg-engie-primary-dark transition-colors duration-200;
}

.btn-secondary {
  @apply bg-white text-engie-primary border-2 border-engie-primary font-semibold py-2 px-4 rounded-md 
         hover:bg-engie-primary-light transition-colors duration-200;
}

/* Cards */
.card {
  @apply bg-white rounded-lg shadow-md p-4 border border-gray-200;
}

/* Search Bar */
.search-bar {
  @apply w-full max-w-md px-4 py-2 rounded-full border border-gray-300 
         focus:outline-none focus:ring-2 focus:ring-engie-primary;
}

/* Map Container */
.map-container {
  @apply h-[calc(100vh-60px)] w-full;
}

/* Leaflet Fixes */
.leaflet-container {
  @apply h-full w-full;
}

.leaflet-popup-content {
  @apply text-engie-text-dark;
}

.leaflet-popup-content-wrapper {
  @apply border-none;
}

/* Utility classes for network status */
.network-engie { @apply text-network-engie; }
.network-engie-soon { @apply text-network-engie-soon; }
.network-high-score { @apply text-network-high-score; }
.network-medium-score { @apply text-network-medium-score; }
.network-low-score { @apply text-network-low-score; }
.network-unknown { @apply text-network-unknown; }
