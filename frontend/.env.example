# ============================================
# Supabase Configuration
# ============================================
# Remplacez les valeurs ci-dessous par celles de votre projet Supabase
# Disponibles dans : Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Voxtral API (Optionnel - pour les recommandations LLM)
# ============================================
# Si vous utilisez Voxtral pour les recommandations
# VOXTRAL_API_KEY=votre_cle_api_voxtral

# ============================================
# Variables Next.js
# ============================================
# Port par défaut pour le développement
PORT=3000

# ============================================
# Instructions
# ============================================
# 1. Copiez ce fichier en .env.local
#    cp .env.example .env.local
#
# 2. Récupérez les valeurs depuis votre projet Supabase :
#    - NEXT_PUBLIC_SUPABASE_URL : Settings > API > Project URL
#    - NEXT_PUBLIC_SUPABASE_ANON_KEY : Settings > API > anon key (public)
#
# 3. Redémarrez votre serveur de développement
#    npm run dev
