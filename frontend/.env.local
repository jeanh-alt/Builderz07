# ============================================
# Supabase Configuration
# ============================================
# Remplacez les valeurs ci-dessous par celles de votre projet Supabase
# Disponibles dans : Settings > API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================
# Voxtral API (Optionnel - pour les recommandations LLM)
# ============================================
# Si vous utilisez Voxtral pour les recommandations
# VOXTRAL_API_KEY=

# ============================================
# Instructions pour obtenir ces valeurs
# ============================================
# 1. Allez sur https://supabase.com
# 2. Sélectionnez votre projet Builderz07
# 3. Allez dans Settings > API
# 4. Copiez :
#    - Project URL → NEXT_PUBLIC_SUPABASE_URL
#    - anon key (public) → NEXT_PUBLIC_SUPABASE_ANON_KEY
# 5. Redémarrez votre serveur : npm run dev
